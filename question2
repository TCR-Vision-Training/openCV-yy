#include <opencv2/opencv.hpp>
#include <iostream>


using namespace cv;
using namespace std;



int main()
{

    // ===============================
    // 1. 读取图片
    // ===============================

    Mat img = imread("../question2/picture2/picture2.png");


    if(img.empty())
    {
        cout << "图片读取失败!" << endl;
        return -1;
    }



    // ===============================
    // 2. 灰度化
    // 霍夫圆检测需要灰度图
    // ===============================

    Mat gray;

    cvtColor(
            img,
            gray,
            COLOR_BGR2GRAY
    );



    // ===============================
    // 3. 高斯滤波
    // 去除噪声，让圆检测更加稳定
    // ===============================

    GaussianBlur(
            gray,
            gray,
            Size(5,5),
            1
    );




    // ===============================
    // 4. 霍夫圆检测
    // 检测所有硬币
    //
    // 半径范围:
    // 1角 约26px
    // 5角 约38px
    // 1元 约50px
    // ===============================


    vector<Vec3f> circles;



    HoughCircles(
            gray,
            circles,
            HOUGH_GRADIENT,

            1,       // 图像缩放比例

            50,      // 两个圆之间最小距离
                     // 防止同一个硬币重复检测

            120,     // 边缘检测阈值

            30,      // 圆检测阈值
                     // 越大越严格

            25,      // 最小半径

            70       // 最大半径
    );




    // ===============================
    // 5. 定义硬币数量
    // ===============================


    int one = 0;        // 1元数量

    int five = 0;       // 5角数量

    int onejiao = 0;    // 1角数量




    // ===============================
    // 6. 遍历检测到的圆
    // 根据半径判断硬币类型
    // ===============================


    for(auto c : circles)
    {


        // 获取圆心坐标和半径

        int x = cvRound(c[0]);

        int y = cvRound(c[1]);

        int r = cvRound(c[2]);







        Scalar color;

        string text;




        // ======================
        // 半径分类
        //
        // 1元:
        // 半径约50
        //
        // 5角:
        // 半径约38
        //
        // 1角:
        // 半径约26
        // ======================



        if(r>=55 && r<=70)
        {

            // 1元

            one++;

            color = Scalar(0,0,255);
            // OpenCV颜色:
            // BGR
            // 红色=(0,0,255)


            text="1Y";

        }



        else if(r>=40 && r<55)
        {

            // 5角

            five++;

            color = Scalar(0,255,0);
            // 绿色


            text="5J";

        }



        else if(r>=22 && r<40)
        {

            // 1角

            onejiao++;

            color = Scalar(255,0,0);
            // 蓝色


            text="1J";

        }



        else
        {
            // 不是硬币
            continue;
        }





        // ======================
        // 绘制圆
        // ======================


        circle(
                img,
                Point(x,y),
                r,
                color,
                3
        );




        // ======================
        // 标记文字
        // ======================


        putText(
                img,
                text,
                Point(x-20,y),
                FONT_HERSHEY_SIMPLEX,
                0.8,
                color,
                2
        );



    }




    // ===============================
    // 7. 计算总金额
    // ===============================


    double total =
            one * 1.0
            +
            five * 0.5
            +
            onejiao * 0.1;




    cout<<endl;

    cout<<"===================="<<endl;

    cout<<"1元数量:"
        <<one
        <<endl;


    cout<<"5角数量:"
        <<five
        <<endl;


    cout<<"1角数量:"
        <<onejiao
        <<endl;



    cout<<"总金额:"
        <<total
        <<"元"
        <<endl;


    cout<<"===================="<<endl;





    // ===============================
    // 8. 在图片上显示结果
    // ===============================


    string info;


    info =
            "1Y:"
            +to_string(one)
            +"  5J:"
            +to_string(five)
            +"  1J:"
            +to_string(onejiao)
            +"  Total:"
            +to_string(total);



    putText(
            img,
            info,
            Point(20,40),
            FONT_HERSHEY_SIMPLEX,
            1,
            Scalar(0,0,0),
            2
    );





    // ===============================
    // 9. 保存结果图片
    // ===============================


    imwrite(
            "../question2/result2.png",
            img
    );



    cout<<"结果图片已保存:"
        <<"result2.png"
        <<endl;




    // ===============================
    // 10. 显示结果
    // ===============================


    imshow(
            "coin result",
            img
    );


    waitKey(0);



    return 0;

}

